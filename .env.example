# Variable de entorno requerida para conectar el Backend a Supabase (PostgreSQL).
# Copia este archivo como .env y reemplaza con tu contraseña real de Supabase.
# NUNCA subas el archivo .env (solo este .example) — ya debe estar en .gitignore.

DB_PASSWORD=tu_password_de_supabase_aqui

# Clave secreta (mínimo 32 caracteres para HS256) y tiempo de expiración (ms) para emisión y validación de JWTs en /api/auth/login.
JWT_SECRET=MiClaveSuperSecretaYLoSuficientementeLargaParaHS25612345
JWT_EXPIRATION=86400000

# Bearer token de respaldo para entornos de prueba locales.
TEST_AUTH_TOKEN=test_token_123

# Coloquen tal cual estas en el .env
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=86cbad86a36afd
MAIL_PASSWORD=3e69e760b1495f
MAIL_FROM=no-reply@savorystudio.com
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000/reset-password
