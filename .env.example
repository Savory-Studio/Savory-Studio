# Variable de entorno requerida para conectar el Backend a Supabase (PostgreSQL).
# Copia este archivo como .env y reemplaza con tu contraseña real de Supabase.
# NUNCA subas el archivo .env (solo este .example) — ya debe estar en .gitignore.

DB_PASSWORD=tu_password_de_supabase_aqui

# Token de prueba enviado en Authorization (Bearer o Basic) hasta el módulo de login.
TEST_AUTH_TOKEN=test-token
