		{
			"name": "1 – REST-01: Creación de Restaurantes",
			"item": [
				{
					"name": "1.1  OwnerA crea Restaurante A (ignora spoofing X-User-Id / ownerId) → 201",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test('Propietario derivado estrictamente del JWT', () => {",
									"    pm.expect(Number(body.ownerId)).to.equal(Number(pm.collectionVariables.get('ownerAId')));",
									"});",
									"pm.test('Campos normalizados y creationDate presente', () => {",
									"    pm.expect(body.name).to.equal('La Parrilla QA');",
									"    pm.expect(body.fullAddress).to.equal('Calle 45 #12-30, Bucaramanga');",
									"    pm.expect(body).to.have.property('restaurantId');",
									"    pm.expect(body).to.have.property('creationDate');",
									"});",
									"pm.collectionVariables.set('restaurantAId', body.restaurantId);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" },
							{ "key": "X-User-Id", "value": "{{ownerBId}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/restaurantes" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"  La Parrilla QA  \",\n  \"description\": \"Asados al carbón\",\n  \"fullAddress\": \"  Calle 45 #12-30, Bucaramanga  \",\n  \"ownerId\": {{ownerBId}}\n}"
						}
					}
				},
				{
					"name": "1.2  OwnerB crea Restaurante B → 201",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.expect(Number(body.ownerId)).to.equal(Number(pm.collectionVariables.get('ownerBId')));",
									"pm.collectionVariables.set('restaurantBId', body.restaurantId);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{ownerBToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/restaurantes" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Sushi Express QA\",\n  \"description\": \"Cocina japonesa\",\n  \"fullAddress\": \"Carrera 33 #48-15\"\n}"
						}
					}
				},
				{
					"name": "1.3  Creación sin nombre obligatorio → 400",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
									"pm.expect(pm.response.json().status).to.equal(400);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/restaurantes" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"   \",\n  \"fullAddress\": \"Calle 10 #20-30\"\n}"
