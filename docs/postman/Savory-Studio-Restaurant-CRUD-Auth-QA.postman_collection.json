		{
			"name": "2 – REST-02: Consulta de Restaurantes Propios y Detalle",
			"item": [
				{
					"name": "2.1  OwnerA lista mis restaurantes (/api/restaurantes/mios) → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"const list = pm.response.json();",
									"pm.expect(list).to.be.an('array').with.lengthOf.at.least(1);",
									"const expectedOwnerId = Number(pm.collectionVariables.get('ownerAId'));",
									"list.forEach(item => pm.expect(Number(item.ownerId)).to.equal(expectedOwnerId));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/restaurantes/mios" }
					}
				},
				{
					"name": "2.2  Outsider sin restaurantes lista /mios → 200 array vacío",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"pm.expect(pm.response.json()).to.be.an('array').that.is.empty;"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{outsiderToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/restaurantes/mios" }
					}
				},
				{
					"name": "2.3  OwnerA consulta detalle de Restaurante A → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"pm.expect(Number(body.restaurantId)).to.equal(Number(pm.collectionVariables.get('restaurantAId')));",
									"pm.expect(Number(body.ownerId)).to.equal(Number(pm.collectionVariables.get('ownerAId')));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/restaurantes/{{restaurantAId}}" }
					}
				},
				{
					"name": "2.4  Detalle con restaurantId no positivo (0) → 400",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
									"pm.expect(pm.response.json().status).to.equal(400);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" }],
						"url": { "raw": "{{baseUrl}}/api/restaurantes/0" }
					}
				},
				{
					"name": "2.5  Consulta sin Bearer token → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/restaurantes/mios" }
					}
				},
