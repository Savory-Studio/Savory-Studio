						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.collectionVariables.set('ownerAId', body.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": { "raw": "{{baseUrl}}/api/auth/register" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Owner\",\n  \"lastName\": \"Uno\",\n  \"birthday\": \"1990-03-15\",\n  \"email\": \"{{ownerAEmail}}\",\n  \"password\": \"SecureP@ss123!\"\n}"
