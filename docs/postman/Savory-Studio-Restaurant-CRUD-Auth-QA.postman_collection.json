							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
									"pm.expect(pm.response.json().status).to.equal(401);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer token.jwt.invalido" }
						],
						"url": { "raw": "{{baseUrl}}/api/restaurantes" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Token Invalido\",\n  \"fullAddress\": \"Calle 1\"\n}"
						}
