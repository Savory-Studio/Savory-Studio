									"// Si no hay cupón con id=1 → puede dar 404",
									"// Si el usuario no es dueño del restaurante → 403",
									"// Lo clave: si el cupón existe, la respuesta debe ser 403 (no 201)",
									"pm.test('Status 403 o 404 (nunca 201)', () => {",
									"    pm.expect(pm.response.code).to.not.eql(201);",
									"    pm.expect([403, 404]).to.include(pm.response.code);",
