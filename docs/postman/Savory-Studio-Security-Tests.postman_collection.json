		{
			"name": "5 – Spoofing de headers",
			"description": "Verifica que X-User-Id inyectado por el cliente no sea aceptado como fuente de identidad.",
			"item": [
				{
					"name": "5.1  X-User-Id sin Bearer token → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
									"pm.test('El header X-User-Id NO otorga acceso sin token', () => {",
									"    pm.expect(pm.response.code).to.eql(401);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-User-Id", "value": "1" }
						],
						"url": { "raw": "{{baseUrl}}/api/promociones/activas" }
					}
				},
				{
					"name": "5.2  X-User-Id contradice JWT → JWT prevalece → 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// El JWT identifica a {{userId}}, pero el path pide cupones del user 999999.",
									"// Aunque X-User-Id diga 999999, la identidad real es del JWT → 403.",
									"pm.test('Status 403 Forbidden (JWT prevalece sobre header)', () => {",
									"    pm.response.to.have.status(403);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "X-User-Id", "value": "999999" }
						],
						"url": { "raw": "{{baseUrl}}/api/coupons/usuario/999999" }
					}
				},
				{
					"name": "5.3  X-User-Id + token válido → acceso propio OK (header ignorado)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// A pesar de enviar X-User-Id: 999999, la identidad viene del JWT.",
									"// Pidiendo los cupones del userId real → 200 (el header se ignora).",
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"pm.test('Respuesta es array (acceso al recurso propio funciona)', () => {",
									"    pm.expect(pm.response.json()).to.be.an('array');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "X-User-Id", "value": "999999" }
						],
						"url": { "raw": "{{baseUrl}}/api/coupons/usuario/{{userId}}" }
					}
				}
			]
		},
