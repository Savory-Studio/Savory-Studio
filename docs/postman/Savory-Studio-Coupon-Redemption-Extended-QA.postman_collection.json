						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customer1Token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/coupons" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"promotionId\": {{promoGlobalId}}\n}"
						}
					}
				},
				{
					"name": "5.4  Canje posterior sobre couponGlobal tras cierre (RN-01/RN-02) → 409",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{ownerAToken}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/canjes" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"couponHash\": \"{{couponGlobalHash}}\"\n}"
						}
					}
				},
				{
					"name": "5.5  Customer2 verifica historial intacto tras cierre a Finished → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"const list = pm.response.json();",
									"const match = list.find(c => Number(c.couponId) === Number(pm.collectionVariables.get('couponGlobalId')));",
									"pm.expect(match).to.be.an('object');",
									"pm.expect(match.status).to.equal('USED');",
									"pm.expect(match.redemptionTimestamp).to.not.be.null;"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{customer2Token}}" }],
						"url": { "raw": "{{baseUrl}}/api/cupones/usuario/{{customer2Id}}" }
					}
				}
			]
		}
	]
}
