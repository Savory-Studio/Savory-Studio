		{
			"name": "1 – Reclamación JWT, Alias /api/cupones y Anti-Suplantación (CUP-01, CUP-02)",
			"item": [
				{
					"name": "1.1  Reclamar sin Bearer token (/api/cupones) → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
									"pm.expect(pm.response.json().status).to.equal(401);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"url": { "raw": "{{baseUrl}}/api/cupones" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"promotionId\": {{promoMainId}}\n}"
						}
					}
				},
				{
					"name": "1.2  Reclamar con JWT manipulado (/api/coupons) → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer token.jwt.invalido" }
						],
						"url": { "raw": "{{baseUrl}}/api/coupons" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"promotionId\": {{promoMainId}}\n}"
						}
					}
				},
				{
					"name": "1.3  Anti-suplantación: Customer1 envía userId de Customer2 en body → 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));",
									"pm.expect(pm.response.json().status).to.equal(403);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customer1Token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/cupones" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": {{customer2Id}},\n  \"promotionId\": {{promoMainId}}\n}"
						}
					}
				},
				{
					"name": "1.4  Anti-suplantación: Customer1 pide /api/cupones/usuario/Customer2 con X-User-Id falso → 403",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customer1Token}}" },
							{ "key": "X-User-Id", "value": "{{customer2Id}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/cupones/usuario/{{customer2Id}}" }
					}
				},
				{
					"name": "1.5  promotionId no positivo (0) al reclamar → 400",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
									"pm.expect(pm.response.json().status).to.equal(400);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customer1Token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/coupons" },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"promotionId\": 0\n}"
						}
					}
